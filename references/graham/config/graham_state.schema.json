{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mildew Graham Presenter State Map",
  "type": "object",
  "required": ["version", "default_state", "states"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "canonical_reference": {"type": "string"},
    "default_state": {"type": "string"},
    "states": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "asset": {"type": ["string", "null"]},
          "fallback": {"type": ["string", "null"]},
          "speech_cycle": {"type": "array", "items": {"type": "string"}},
          "camera_motion": {"type": "string"},
          "recommended_hold_seconds": {
            "type": "array",
            "prefixItems": [{"type": "number"}, {"type": "number"}],
            "minItems": 2,
            "maxItems": 2
          },
          "visible_speech": {"type": "boolean"},
          "supplementary": {"type": "boolean"},
          "missing": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
