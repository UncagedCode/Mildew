{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mildew://schemas/private_interference.schema.json",
  "title": "Mildew Private Controller Interference",
  "type": "object",
  "required": ["id", "source", "display_ms", "target_count", "log_to_player_history", "payload_type"],
  "properties": {
    "id": {"type": "string"},
    "source": {"enum": ["production", "announcer", "graham", "unknown", "unknown_impersonation", "corruption", "archive"]},
    "claimed_source": {"type": ["string", "null"]},
    "truth_mode": {"enum": ["true", "false", "ambiguous", "irrelevant", "randomized"]},
    "payload_type": {"enum": ["text_overlay", "temporary_ui_replace", "vibration", "backstage_still", "name_glitch", "timer_glitch", "button_flash", "input_field_replace", "drawing_mark", "mixed"]},
    "text": {"type": ["string", "null"]},
    "display_ms": {"type": "integer", "minimum": 100},
    "target_count": {"type": "integer", "minimum": 1, "maximum": 8},
    "dismiss_on_touch": {"type": "boolean"},
    "touch_replacement_text": {"type": ["string", "null"]},
    "vibration_pattern_ms": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "log_to_player_history": {"const": false},
    "requires_flags": {"type": "array", "items": {"type": "string"}},
    "sets_flags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
