{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mildew://schemas/do_not_press_that_puzzle.schema.json",
  "title": "Mildew Do Not Press That Puzzle",
  "type": "object",
  "required": [
    "id",
    "enabled",
    "quality_status",
    "objective",
    "supported_player_counts",
    "roles",
    "success_tiers"
  ],
  "properties": {
    "id": {"type": "string"},
    "enabled": {"type": "boolean"},
    "quality_status": {"enum": ["placeholder", "draft", "reviewed", "approved"]},
    "objective": {"type": "string"},
    "supported_player_counts": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 2, "maximum": 8},
      "uniqueItems": true
    },
    "roles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "panel_type", "instructions"],
        "properties": {
          "id": {"type": "string"},
          "panel_type": {"type": "string"},
          "instructions": {"type": "array", "items": {"type": "string"}},
          "controls": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": true
      }
    },
    "allocation_rules": {"type": "object"},
    "mistake_consequences": {"type": "array", "items": {"type": "object"}},
    "success_tiers": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "time_limit_seconds": {"type": "integer", "minimum": 10},
    "irrelevant_controls_allowed": {"type": "boolean"}
  },
  "additionalProperties": true
}
