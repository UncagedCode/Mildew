{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mildew://schemas/factual_content.schema.json",
  "title": "Mildew Factual Content",
  "type": "object",
  "required": ["id", "enabled", "quality_status", "familiarity_tier", "content_tags", "fact", "sources"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "enabled": {"type": "boolean"},
    "quality_status": {"enum": ["placeholder", "draft", "reviewed", "approved"]},
    "familiarity_tier": {"type": "integer", "minimum": 1, "maximum": 5},
    "content_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "fact": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "publisher_or_organisation", "reference", "supported_claim"],
        "properties": {
          "title": {"type": "string"},
          "publisher_or_organisation": {"type": "string"},
          "reference": {"type": "string"},
          "supported_claim": {"type": "string"},
          "verified_at": {"type": ["string", "null"]},
          "review_note": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_path", "source", "licence", "approval_status"],
        "properties": {
          "asset_path": {"type": "string"},
          "source": {"type": "string"},
          "creator_or_rights_holder": {"type": ["string", "null"]},
          "licence": {"type": "string"},
          "attribution_required": {"type": "boolean"},
          "attribution_text": {"type": ["string", "null"]},
          "approval_status": {"enum": ["placeholder", "pending", "approved", "rejected"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
