# Copy this file to .env. Never commit .env.
ELEVENLABS_API_KEY=replace_me
GRAHAM_VOICE_ID=replace_me

# Locked Graham v1 defaults
GRAHAM_MODEL_ID=eleven_v4
GRAHAM_OUTPUT_FORMAT=mp3_44100_128
GRAHAM_SPEED=1.0
GRAHAM_STABILITY=0.50
GRAHAM_SIMILARITY=0.75
GRAHAM_SEED=1998

# FREE-FIRST SAFETY: the script refuses to generate once the account usage plus
# the requested batch would exceed this number. Keep below the free-plan allowance.
GRAHAM_MONTHLY_HARD_CAP=8000
