  "speaker": "graham",
  "_comment": "Checkpoint 1 Graham line pools. Slots: {name} display name (spoken as the stored speech name), {secs}, {answer}, {count}, {points}. 'moods' restricts eligibility (empty = any). 'audio' is the future pre-rendered asset id (null = runtime TTS). Ordinary presenter language first; jokes are the exception.",
  "items": [
    {"id": "g.lobby_empty.1", "category": "lobby_empty", "text": "Good evening. We appear to have no contestants.", "enabled": true, "quality_status": "draft"},
    {"id": "g.lobby_empty.2", "category": "lobby_empty", "text": "We're live, apparently. Nobody's here.", "enabled": true, "quality_status": "draft"},
    {"id": "g.lobby_empty.3", "category": "lobby_empty", "text": "Take your time. We've only got the one studio.", "enabled": true, "quality_status": "draft"},
    {"id": "g.lobby_empty.4", "category": "lobby_empty", "text": "I've done this programme in front of fewer people. Not many fewer.", "enabled": true, "quality_status": "draft"},
    {"id": "g.lobby_empty.5", "category": "lobby_empty", "text": "Phones out, please. The little code on the side of the screen. Yes, that one.", "enabled": true, "quality_status": "draft"},

    {"id": "g.lobby_one.1", "category": "lobby_one", "text": "One is not really a party.", "enabled": true, "quality_status": "draft"},
    {"id": "g.lobby_one.2", "category": "lobby_one", "text": "Just the one, then. {name}, you'll need a friend.", "enabled": true, "quality_status": "draft"},
    {"id": "g.lobby_one.3", "category": "lobby_one", "text": "{name}. On your own. Bring somebody.", "enabled": true, "quality_status": "draft", "moods": ["irritated", "relaxed"]},

    {"id": "g.lobby_join.1", "category": "lobby_join", "text": "{name}. Lovely.", "enabled": true, "quality_status": "draft"},
    {"id": "g.lobby_join.2", "category": "lobby_join", "text": "And here's {name}.", "enabled": true, "quality_status": "draft"},
    {"id": "g.lobby_join.3", "category": "lobby_join", "text": "Welcome, {name}.", "enabled": true, "quality_status": "draft"},
    {"id": "g.lobby_join.4", "category": "lobby_join", "text": "{name} has joined us. Brave.", "enabled": true, "quality_status": "draft"},
    {"id": "g.lobby_join.5", "category": "lobby_join", "text": "{name}. Take a podium. Any podium.", "enabled": true, "quality_status": "draft"},

    {"id": "g.lobby_returning.1", "category": "lobby_returning", "text": "{name}. Back again.", "enabled": true, "quality_status": "draft"},
    {"id": "g.lobby_returning.2", "category": "lobby_returning", "text": "Ah. {name}.", "enabled": true, "quality_status": "draft"},
    {"id": "g.lobby_returning.3", "category": "lobby_returning", "text": "Welcome back, {name}. We kept your podium warm. Roughly.", "enabled": true, "quality_status": "draft"},

    {"id": "g.lobby_ready.1", "category": "lobby_ready", "text": "That's enough of you. Whenever you're ready.", "enabled": true, "quality_status": "draft"},
    {"id": "g.lobby_ready.2", "category": "lobby_ready", "text": "{name}, you're in charge of the button. Press it when everybody's in.", "enabled": true, "quality_status": "draft"},
    {"id": "g.lobby_ready.3", "category": "lobby_ready", "text": "Somebody press the button. Not me. I'm not allowed.", "enabled": true, "quality_status": "draft"},

    {"id": "g.lobby_left.1", "category": "lobby_left", "text": "{name} has gone home.", "enabled": true, "quality_status": "draft"},
    {"id": "g.lobby_left.2", "category": "lobby_left", "text": "And {name} is gone. Fine.", "enabled": true, "quality_status": "draft"},

    {"id": "g.name_match.1", "category": "name_match", "text": "We've had a {name} before.", "enabled": true, "quality_status": "draft"},
