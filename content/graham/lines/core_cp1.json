    {"id": "g.intro.4", "category": "intro_player", "text": "{name}. Lovely to have you.", "enabled": true, "quality_status": "draft"},
    {"id": "g.intro.5", "category": "intro_player", "text": "{name}. We've heard a lot about you.", "enabled": true, "quality_status": "draft"},
